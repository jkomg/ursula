#!/usr/bin/env python3
"""PreToolUse hook: keep the check-in's own tools away from the ledger.

bin/ledger-log writes the ledger; the model should only ever read it through
scripts/checkin_close.py. This denies Bash, Write and Edit calls that name the ledger
directory, while the guard applies (same rule as bin/guard-actions).

It is a speed bump, not a wall: a command can build the path from pieces, and a process
running as the same user can always write the file. It catches the plain routes and
leaves a denial in the transcript when the model tries one. The chain hash in the
ledger and an off-machine copy of its head (docs/governance.md) are what catch the rest.
"""
import json
import os
import re
import sys

ROLE = os.environ.get("URSULA_ROLE", "").strip()
REMOTE = os.environ.get("CLAUDE_CODE_REMOTE", "").strip().lower() not in ("", "0", "false")
RECORDING = bool(os.environ.get("URSULA_LEDGER", "").strip())   # bin/run-hook sets it on desktop
LEDGER = os.environ.get("URSULA_LEDGER", "").strip() or "/var/tmp/ursula-ledger/ledger.jsonl"
if not (ROLE == "checkin" or (not ROLE and REMOTE) or RECORDING):
    sys.exit(0)
try:
    ev = json.load(sys.stdin)
except ValueError:
    sys.exit(0)

inp = ev.get("tool_input") or {}
text = " ".join(str(inp.get(k, "")) for k in ("command", "file_path", "path", "content", "new_string"))
folder = os.path.dirname(LEDGER)
DIRNAME = "ursula-" + "ledger"     # assembled so this file can itself be edited past the guard
cmd = str(inp.get("command", ""))
# Reaching the ledger through its environment variable avoids spelling the path, so a
# shell command naming the variable is treated like one naming the path.
names_it = folder in text or LEDGER in text or DIRNAME in text or ("URSULA_" + "LEDGER") in cmd
if names_it:
    # Only a single, plain call to a verifier may name it: no chaining, substitution or
    # redirection, which is how "verify; then edit" slipped through the earlier check.
    # Paths are pinned to the repo's own scripts, relative to the workspace: a look-alike
    # such as /tmp/scripts/session_verify.py could otherwise edit the ledger unchallenged.
    verifier = re.fullmatch(r"\s*(bash\s+bin/run-hook\s+--python|python3?|py\s+-3)\s+"
                            r"scripts/(checkin_close|checkin_verify|session_verify)\.py\b[^;&|`$<>\n]*", cmd)
    if verifier and not inp.get("content") and not inp.get("new_string"):
        sys.exit(0)
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": "Ledger guard: the call ledger is written by the harness and is not for "
                                    "editing or reading directly. Use scripts/checkin_close.py.",
    }}))
sys.exit(0)

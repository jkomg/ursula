#!/usr/bin/env python3
"""PreToolUse hook: keep the LiteLLM key out of Ursula's own commands.

Blocks a Bash command that names the key variable, dumps the environment, or
reads a process environment, unless it goes through bin/litellm. This is a
guard rail against accidents and against mined text talking the agent into
printing it. It is not a security boundary: anything that can run code in the
same sandbox can still reach the variable.
"""
import json
import re
import sys

try:
    event = json.load(sys.stdin)
except ValueError:
    sys.exit(0)

cmd = (event.get("tool_input") or {}).get("command", "")
through_wrapper = re.fullmatch(r"\s*(\./)?bin/litellm(\s[^;&|`$]*)?(\s*<\s*\S+)?\s*", cmd) is not None

patterns = [
    r"LITELLM_API_KEY",
    r"(^|[;&|]\s*)(env|printenv|export|set|declare\s+-x)\s*($|[;&|>])",
    r"/proc/[^\s]*/environ",
    r"ursula-litellm",           # the Keychain item
]
if not through_wrapper and any(re.search(p, cmd) for p in patterns):
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": "Ursula never reads the LiteLLM key. Use bin/litellm check | models | chat MODEL.",
        }
    }))
sys.exit(0)

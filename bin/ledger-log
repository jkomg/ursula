#!/usr/bin/env python3
"""PostToolUse hook: an append-only record of what a check-in actually called.

The run record is written by the model, so anything in it can be wrong or invented.
This ledger is written by the harness, after each connector or board call returns, with
the harness's own clock. scripts/checkin_verify.py compares the run's claims
("opened 2 documents", "read Gmail", "re-evaluated 4 findings") with it.

One JSON line per call: seq, ts, session, tool, a short summary of the arguments (never
message text or a document body), whether it errored, the size and sha256 of the
response, and `prev`, the sha256 of the previous line. Editing or deleting a line
breaks the chain from that point on, which the verifier reports.

  URSULA_LEDGER   path of the ledger (default /var/tmp/ursula-ledger/ledger.jsonl)

It records only when the check-in guard would apply (bin/guard-actions: URSULA_ROLE=checkin,
or a cloud session with no role) or when URSULA_LEDGER is set. Otherwise it does nothing.
It never blocks a call and never prints: a failure to log must not stop a check-in.

What this does not do: it cannot stop a process running as the same user from editing
the file, and the chain only shows that an edit happened if the final hash is kept
somewhere else. bin/guard-ledger denies the obvious routes (Bash, Write, Edit naming the
ledger) and checkin_close.py prints the head hash for the run record. Anchoring the head
off the machine is the next step (docs/governance.md).
"""
import datetime
import hashlib
import json
import os
import sys

ROLE = os.environ.get("URSULA_ROLE", "").strip()
REMOTE = os.environ.get("CLAUDE_CODE_REMOTE", "").strip().lower() not in ("", "0", "false")
LEDGER = os.environ.get("URSULA_LEDGER", "").strip()
ACTIVE = bool(LEDGER) or ROLE == "checkin" or (not ROLE and REMOTE)
LEDGER = LEDGER or "/var/tmp/ursula-ledger/ledger.jsonl"

KEEP = ("action", "collection", "doc_id", "documentId", "fileId", "file_id", "id", "channel_id",
        "q", "query", "jql", "cloudId", "maxResults", "userId", "calendarId", "timeMin", "timeMax",
        "message_ts", "oldest", "latest", "issueIdOrKey", "pageId")


def short(v):
    return v if isinstance(v, (int, float, bool)) else str(v)[:200]


def summarise(args):
    out = {}
    if not isinstance(args, dict):
        return out
    nested = args.get("params") if isinstance(args.get("params"), dict) else {}   # gws_* tools nest theirs
    for k in KEEP:
        if k in args:
            out[k] = short(args[k])
        elif k in nested:
            out[k] = short(nested[k])
    return out


def lock(fh):
    """Exclusive lock for the append; fcntl does not exist on Windows (observed 2026-10-28)."""
    try:
        import fcntl
        fcntl.flock(fh, fcntl.LOCK_EX)
    except ImportError:
        import msvcrt
        fh.seek(0)
        msvcrt.locking(fh.fileno(), msvcrt.LK_LOCK, 1)   # retries for ~10 s, then raises


def main():
    if not ACTIVE:
        return
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    name = ev.get("tool_name", "")
    if not (name.startswith("mcp__") or name in ("ArtifactData", "Artifact")):
        return
    resp = ev.get("tool_response")
    body = resp if isinstance(resp, str) else json.dumps(resp, sort_keys=True, default=str)
    err = bool(isinstance(resp, dict) and (resp.get("is_error") or resp.get("error"))) or \
        (isinstance(resp, str) and resp.lstrip().lower().startswith(("error", "<tool_use_error")))
    os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
    with open(LEDGER, "a+b") as fh:
        lock(fh)
        fh.seek(0, os.SEEK_END)
        size = fh.tell()
        fh.seek(max(0, size - 8192))
        lines = fh.read().splitlines()
        last = lines[-1] if lines else b""
        prev = hashlib.sha256(last).hexdigest() if last else "0" * 64
        seq = (json.loads(last)["seq"] + 1) if last else 1
        entry = {
            "seq": seq,
            "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "session": ev.get("session_id", ""),
            "tool": name.split("__")[-1] if name.startswith("mcp__") else name,
            "args": summarise(ev.get("tool_input")),
            "error": err,
            "bytes": len(body),
            "sha256": hashlib.sha256(body.encode("utf-8", "replace")).hexdigest(),
            "prev": prev,
        }
        fh.write((json.dumps(entry, sort_keys=True) + "\n").encode())
        fh.flush()


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)

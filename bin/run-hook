#!/usr/bin/env bash
# Run one of Ursula's Python hooks with a Python that actually works.
#
#   bash bin/run-hook guard-secrets      (stdin: the hook event JSON)
#   bash bin/run-hook --which            print the interpreter it would use
#
# Why: the hooks used to be invoked as `python3`. On Windows that name is often the
# Microsoft Store stub, which prints "Python was not found" and exits 49. Claude Code
# treats any exit other than 0 or 2 as a non-blocking error, so every guard silently
# did nothing (observed 2026-10-28). This finds a real interpreter and, if there is
# none, fails closed: exit 2 blocks the tool call and tells the operator why.

set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

works() { "$@" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; }

PY=()
find_python() {
  if [ -n "${URSULA_PYTHON:-}" ] && works "$URSULA_PYTHON"; then PY=("$URSULA_PYTHON"); return 0; fi
  for c in python3 python; do
    if command -v "$c" >/dev/null 2>&1 && works "$c"; then PY=("$c"); return 0; fi
  done
  if command -v py >/dev/null 2>&1 && works py -3; then PY=(py -3); return 0; fi
  # Windows user-scope installs that are not on PATH.
  for base in "${LOCALAPPDATA:-}" "${LocalAppData:-}"; do
    [ -n "$base" ] || continue
    for exe in "$base"/Programs/Python/Python3*/python.exe; do
      [ -e "$exe" ] && works "$exe" && { PY=("$exe"); return 0; }
    done
  done
  return 1
}

find_python || {
  echo "Ursula safety hook could not find Python 3.8+ (python3, python, py -3 or" \
       "LOCALAPPDATA/Programs/Python). The tool call is blocked so the guard cannot be" \
       "skipped silently. Install Python or set URSULA_PYTHON to its full path." >&2
  exit 2
}

if [ "${1:-}" = "--which" ]; then echo "${PY[*]}"; exit 0; fi
# --python ARGS...: run the found interpreter directly (rails-check, install.sh).
if [ "${1:-}" = "--python" ]; then shift; exec "${PY[@]}" "$@"; fi
name="${1:?usage: run-hook HOOK_NAME}"
case "$name" in guard-secrets|guard-actions|guard-ledger|ledger-log) ;; *)
  echo "run-hook: unknown hook $name" >&2; exit 2 ;;
esac
shift
# Not exec: a guard that crashes exits 1, which Claude Code treats as non-blocking, so
# the call would go through unguarded. Turn any unexpected exit into 2 (block).
"${PY[@]}" "$here/$name" "$@"
rc=$?
case "$rc" in
  0|2) exit "$rc" ;;
  *) echo "Ursula hook $name failed (exit $rc); blocking the call rather than running unguarded." >&2; exit 2 ;;
esac
